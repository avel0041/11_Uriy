    "from itertools import*\n",
    "\n",
    "k = 0\n",
    "for x in product('01', repeat = 13):\n",
    "    a = ''.join(x)\n",
    "    if ( 7+a.count('1') )%2 == 0:\n",
    "        k+=1\n",
    "print(k)\n",
